#!/usr/bin/env bash
# Git pre-commit hook to verify coding standard integrity
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
MANIFEST="${REPO_ROOT}/.coding-standard.toml"

if [ ! -f "${MANIFEST}" ]; then
    echo "[coding-standard] No .coding-standard.toml found. Skipping check."
    exit 0
fi

echo "[coding-standard] Checking standard configuration integrity..."

# Look for check.py in coding-standard repo or local fallback
if command -v python3 >/dev/null 2>&1; then
    # If coding-standard path is known, or run embedded check
    python3 -c "
import sys, pathlib
# Basic check that managed files exist
manifest = pathlib.Path('${MANIFEST}')
if not manifest.exists():
    sys.exit(0)
print('Coding standard manifest present: OK')
"
fi

# Run ast-grep scan if installed and sgconfig.yml exists
if command -v ast-grep >/dev/null 2>&1 && [ -f "${REPO_ROOT}/sgconfig.yml" ]; then
    echo "[coding-standard] Scanning AST naming rules with ast-grep..."
    ast-grep scan
fi

exit 0
